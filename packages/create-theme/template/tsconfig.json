{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@theme/*": ["./src/*", "./node_modules/@entirius/theme-default/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
